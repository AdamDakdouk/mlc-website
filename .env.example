MONGODB_URI=mongodb://127.0.0.1:27017/mlc-dev
JWT_SECRET=replace-with-a-random-32-plus-character-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Email sending (Mailtrap sandbox in development; the school's real
# provider in production — see docs/deployment.md)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Sender shown on every email: "Name" <address>. The address must belong to a
# domain verified with the email provider.
EMAIL_FROM="Modernistic Learning Community" <info@modernisticlearning.com>
# Where new meeting request / application alerts are sent (defaults to the public site email)
ADMIN_NOTIFY_EMAIL=

# Public address of the site (sitemap, robots.txt, links in emails). Also needed at build time.
SITE_URL=http://localhost:3000

# Production only -----------------------------------------------------------
# Folder for everything uploaded at runtime. Set to the host's persistent disk
# mount (e.g. /var/data); unset in development (uses the project folder).
# UPLOAD_ROOT=/var/data
# Number of trusted reverse proxies in front of the app, used to find the real
# visitor IP for rate limiting. Test the right value after deploying (see
# docs/deployment.md); leave unset in development.
# TRUSTED_PROXY_HOPS=1
